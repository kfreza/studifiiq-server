PORT=5000
CS_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
CS_DB_NAME=studioSpaceDB
CS_CLIENT_URL=http://localhost:3000
CS_JWT_SECRET=replace-with-a-long-random-string
